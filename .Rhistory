# histogram of observed scores
hist(Xs)
# plot observed scores as compared to True Score
plot(1:n.obs, Xs, ylim=ylims, pch=21, bg=ifelse(Xs<=cut_off, "black", "white"))
lines(1:n.obs, Xs)
abline(h=T)
abline(h=cut_off, lty=2) # here I simulate data as the participant is equal to the population mean
png(paste0("Figures/Figure_true_obs_", E.sd, ".png"), res=200, height=800, width=1200)
plot(1:n.obs, Xs, ylim=ylims, pch=21, bg=ifelse(Xs<=cut_off, "black", "white"), main=label)
lines(1:n.obs, Xs)
abline(h=T)
abline(h=cut_off, lty=2) # here I simulate data as the participant is equal to the population mean
dev.off()
}
simulate_obs(Xs=37, nobs = 20, Mean.T=40, E.sd=1.5, Mean.E.sd=5, label="High Reliability")
