names(ES.s)=c("ES0(oTL)-ES1", "ES1-ES2", "ES2-ES3", "ES3-ES4")
res = list(ES.n, ES.s)
names(res) = c("Observations", "Adjusted_Scores")
return(res)
} else {
res = ES.n
return(res)
}
}
