set.seed(2026)
library(irr)
n <- 1000000
# --- Funzione: interi ~ normale troncata con matching approx mean/sd ---
rtruncnorm_int_match <- function(n, mean_target, sd_target, min_val, max_val,
max_iter = 25, tol_mean = 0.05, tol_sd = 0.05) {
mu <- mean_target
sig <- sd_target
draw_once <- function(mu, sig) {
x <- numeric(0)
while (length(x) < n) {
m <- (n - length(x)) * 3
y <- rnorm(m, mean = mu, sd = sig)
y <- y[y >= min_val & y <= max_val]
x <- c(x, y)
}
x <- x[1:n]
x <- round(x)
x <- pmin(pmax(x, min_val), max_val)
x
}
x <- draw_once(mu, sig)
for (i in 1:max_iter) {
m <- mean(x); s <- sd(x)
if (abs(m - mean_target) < tol_mean && abs(s - sd_target) < tol_sd) break
mu  <- mu + 0.7 * (mean_target - m)
sig <- sig * (1 + 0.7 * ((sd_target / s) - 1))
sig <- max(sig, 0.5)
x <- draw_once(mu, sig)
}
x
}
# --- 1) Simula Age/Education come interi con le caratteristiche del campione originale ---
Age <- rtruncnorm_int_match(n, mean_target = 66.23, sd_target = 9.37, min_val = 50, max_val = 85)
Education <- rtruncnorm_int_match(n, mean_target = 13.00, sd_target = 3.80, min_val = 5, max_val = 24)
# Sex 0/1 (cambia p se nel tuo campione non è ~50/50)
Sex <- rbinom(n, 1, 0.5)
# Trasformazioni usate nelle formule di aggiustamento (log naturale)
logAge <- log10(Age)
logm100Edu <- log(100 - Education)
# --- 2) Simula span di cifre in avanti (Adjusted vero) coerente con la media osservata ---
# Media: 6.93333
# SD residuale dal tuo modello: ~1.71 (usiamola come dispersione plausibile dell'abilità)
Adj_true <- rnorm(n, mean = 6.93333, sd = 1.71)
# --- 3) Costruisci Observed score aggiungendo l'effetto demografico del METODO 1 ---
# Formula 1:
# Adjusted = Observed - [ -2.19*(log(Age)-1.817) -7.16*(logm100(Edu)-4.465) -0.512*(Sex-0.5) ]
# => Observed = Adjusted + bracket
bracket1 <- (-2.19)  * (logAge      - 1.817) +
(-7.16)  * (logm100Edu  - 4.465) +
(-0.512) * (Sex         - 0.5)
Observed_latent <- Adj_true + bracket1
# Punteggio osservato intero 0–14
Observed <- pmin(pmax(round(Observed_latent), 0), 14)
# --- 4) Calcola Adjusted score con i due metodi (usando le tue formule) ---
# Metodo 1
Adj1 <- Observed - bracket1
# Metodo 2
bracket2 <- (-1.638) * (logAge      - 1.817) +
(-7.822) * (logm100Edu  - 4.465) +
(-0.412) * (Sex         - 0.5)
Adj2 <- Observed - bracket2
dat <- data.frame(Age, Education, Sex, Observed, Adj1, Adj2)
# Controlli rapidi
cat("Age mean/sd:", round(mean(dat$Age),2), round(sd(dat$Age),2), "range", min(dat$Age), max(dat$Age), "\n")
cat("Edu mean/sd:", round(mean(dat$Education),2), round(sd(dat$Education),2), "range", min(dat$Education), max(dat$Education), "\n")
cat("Observed mean/sd:", round(mean(dat$Observed),3), round(sd(dat$Observed),3), "range", min(dat$Observed), max(dat$Observed), "\n")
# --- 5) Classificazione ES sugli ADJUSTED (continui) ---
classify_ES <- function(x, c01, c12, c23, c34) {
cut(x,
breaks = c(-Inf, c01, c12, c23, c34, Inf),
labels = c("ES0", "ES1", "ES2", "ES3", "ES4"),
ordered_result = TRUE, right = TRUE, include.lowest = TRUE)
}
# Soglie Sistema 1 (per Adj1)
dat$ES_sys1 <- classify_ES(dat$Adj1, 4.100569, 4.956812, 5.964502, 6.853992)
# Soglie Sistema 2 (per Adj2)
dat$ES_sys2 <- classify_ES(dat$Adj2, 4.004684, 4.911006, 5.914929, 6.794409)
# --- 6) Discordanza + tabella ---
discordanza <- mean(dat$ES_sys1 != dat$ES_sys2)
cat("Percentuale di discordanza:", round(100 * discordanza, 2), "%\n\n")
tab <- table(Sys1 = dat$ES_sys1, Sys2 = dat$ES_sys2)
print(tab)
# --- 7) kappa2 ---
ratings <- data.frame(
s1 = factor(dat$ES_sys1, levels = c("ES0","ES1","ES2","ES3","ES4")),
s2 = factor(dat$ES_sys2, levels = c("ES0","ES1","ES2","ES3","ES4"))
)
k_unw <- kappa2(ratings, weight = "unweighted")
k_w   <- kappa2(ratings, weight = "squared")
cat("Kappa non pesato:", k_unw$value, "\n")
cat("Kappa pesato quadratico:", k_w$value, "\n")
